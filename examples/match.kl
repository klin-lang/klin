// `match` — default break (no fallthrough), value groups, ranges,
// relational patterns, and `when` guards. Lowers to a plain if/else chain;
// the subject is evaluated once.

fn classify(x: i32) {
    match x {
        1, 2, 3 {
            puts("small")
        }
        4..=10 {
            puts("mid")
        }
        else {
            puts("big")
        }
    }
}

fn main() {
    classify(2)
    classify(7)
    classify(99)

    // Expression form: every arm yields a value, `else` is required.
    let x = 7
    let fee = match x {
        0 { 0 }
        1..=5 { 10 }
        else { 25 }
    }
    printf("fee=%d\n", fee)

    // Relational patterns and `when` guards.
    let ready = 1
    match x {
        > 0 when ready != 0 {
            puts("ready-pos")
        }
        _ when x == 0 {
            puts("zero-guard")
        }
        else {
            puts("other")
        }
    }
    let kind = match x {
        < 0 { -1 }
        > 10 { 2 }
        else { 1 }
    }
    printf("kind=%d\n", kind)

    // Untyped arms take the annotated type (D12), including `1 + 2`.
    let small: u8 = match x {
        0 { 1 + 2 }
        else { 4 }
    }
    printf("small=%d\n", cast(i32, small))

    // `break` / `continue` inside an arm belong to the enclosing loop,
    // because an arm is an `if` branch, not a C `case`.
    let mut sum = 0
    for i in 0..<10 {
        match i {
            0, 1 {
                continue
            }
            7 {
                break
            }
            else {
                sum = sum + i
            }
        }
    }
    printf("sum=%d\n", sum)
}
