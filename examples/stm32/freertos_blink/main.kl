/// Nucleo-F411RE FreeRTOS blink (issue 028).
/// ≥2 tasks: LED toggle on PA5 + a second delay-only task.
/// Prerequisites: klin get (see klin.mod). Emit-c / compile against freertos_stubs
/// or a real FreeRTOS include path — see README.
import "github/klin-lang/klin_freertos" freertos
import "github/klin-lang/machine_stm32" machine

/// Blink the user LED (PA5) with an explicit FreeRTOS delay (no busy-wait).
$rtos_task(blink, 512, 2) {
    let led = machine.pin_out(machine.Port.A, 5)
    while true {
        led.toggle()
        // ticks — with configTICK_RATE_HZ=1000 this is ~200 ms
        freertos.task_delay(200)
    }
}

/// Second task: proves the scheduler runs more than one runnable.
$rtos_task(heartbeat, 256, 1) {
    while true {
        freertos.task_delay(1000)
    }
}

@[link("board/startup.s")]
fn main() {
    start_blink()
    start_heartbeat()
    freertos.task_start_scheduler()
}
