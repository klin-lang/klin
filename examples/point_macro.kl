// Same as point.kl, built with a compile-time $fn macro.
// Run: dart run bin/klin.dart run examples/point_macro.kl
// Peek: dart run bin/klin.dart --emit-pp examples/point_macro.kl
// See: docs/04-macros.md

$fn point(name: name, T: type) {
  struct $name {
    x: $T
    y: $T
  }
  fn (p: $name) len_sq(): $T {
    return p.x * p.x + p.y * p.y
  }
}

$point(Vec2i, i32)

fn main() {
  let v = Vec2i{ 3, 4 }
  printf("%d\n", v.len_sq())
}
