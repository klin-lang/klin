struct Token {
    kind: i32
    n: i32
}

fn main() {
    let mut buf: [4]Token = [Token{ kind: 1, n: 0 }, Token{ kind: 2, n: 0 }, Token{ kind: 3, n: 0 }, Token{ kind: 4, n: 0 }]
    let p = cast(*mut [4]Token, cast(usize, &buf))
    let mut s = (*p)[1:3]
    s[0].n = 9
    (*p)[0].kind = 8
    printf("%d %d\n", buf[0].kind, buf[1].n)
}
