// Destructuring in `let` (issue 056).
// Phase A: `let { x, y } = p`       (struct fields, by name)
// Phase C: `let [a, b] = xs`        (fixed-length array `[N]T`, positional)
// Phase D: `let { x: px } = p`      (rename) and `let [_, b] = xs` (skip)
// Phase A': `{ x, y } = p`          (assign fields to existing places)
// All lower to plain reads (`.field` / `xs[i]`) — they disappear in C.

struct Vec2 {
    x: i32
    y: i32
}

fn origin_offset(): Vec2 {
    return Vec2{ x: 10, y: 20 }
}

fn show_both() {
    let p = Vec2{ x: 3, y: 4 }
    let { x, y } = p
    printf("p = (%d, %d)\n", x, y)
}

fn show_subset() {
    let p = Vec2{ x: 3, y: 4 }
    // A subset of fields is fine; order does not matter.
    let { y } = p
    printf("just y = %d\n", y)
}

fn show_mut() {
    let p = Vec2{ x: 3, y: 4 }
    // `let mut` makes the bindings mutable.
    let mut { x } = p
    x = x + 100
    printf("x + 100 = %d\n", x)
}

fn show_expr_source() {
    // Any expression works as the source; it is evaluated once.
    let { x, y } = origin_offset()
    printf("offset = (%d, %d)\n", x, y)
}

fn show_array() {
    // Fixed-length array `[N]T`: one binding per element (N must match).
    let xs: [3]i32 = [10, 20, 30]
    let [a, b, c] = xs
    printf("array = %d %d %d\n", a, b, c)
}

fn show_array_literal() {
    // An array-literal source binds element-wise.
    let [p, q] = [7, 8]
    printf("literal = %d, %d\n", p, q)
}

fn pair_once(n: *mut i32): [2]i32 {
    *n = *n + 1
    return [10, 20]
}

fn show_array_call() {
    // A returned `[N]T` is evaluated once, then read from the temporary.
    let mut n: i32 = 0
    let [x, y] = pair_once(&n)
    printf("call = %d %d (n = %d)\n", x, y, n)
}

fn show_rename() {
    // Rename fields to different local names (phase D).
    let p = Vec2{ x: 3, y: 4 }
    let { x: px, y: py } = p
    printf("rename = (%d, %d)\n", px, py)
}

fn show_skip() {
    // `_` skips a position; the remaining indices are preserved (phase D).
    let xs: [4]i32 = [10, 20, 30, 40]
    let [_, b, _, d] = xs
    printf("skip = %d, %d\n", b, d)
}

fn show_bare_assign() {
    // Bare `{ … } = p` assigns fields to already-declared places (phase A').
    let mut x: i32 = 0
    let mut y: i32 = 0
    let p = Vec2{ x: 7, y: 8 }
    { x, y } = p
    printf("bare = (%d, %d)\n", x, y)
}

fn main() {
    show_both()
    show_subset()
    show_mut()
    show_expr_source()
    show_array()
    show_array_literal()
    show_array_call()
    show_rename()
    show_skip()
    show_bare_assign()
}
