fn take(ok: bool): !i32 {
    if ok {
        return 7
    }
    return error(3)
}

fn use(ok: bool): i32 {
    let n = take(ok) or { return err }
    return n
}

fn sum_skip(): i32 {
    let xs: [3]i32 = [1, 0, 1]
    let mut sum = 0
    let mut i = 0
    while i < 3 {
        let bit = xs[i]
        i = i + 1
        let n = take(bit != 0) or { continue }
        sum = sum + n
    }
    return sum
}

fn main() {
    printf("%d\n", use(true))
    printf("%d\n", use(false))
    printf("%d\n", sum_skip())
}
