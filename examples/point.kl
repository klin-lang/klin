// Canonical Vec2i + len_sq (no macros). Pair: point_macro.kl
// Run: dart run bin/klin.dart run examples/point.kl
// See: docs/04-macros.md

struct Vec2i {
    x: i32
    y: i32
}

fn (p: Vec2i) len_sq(): i32 {
    return p.x * p.x + p.y * p.y
}

fn main() {
    let v = Vec2i{ 3, 4 }
    printf("%d\n", v.len_sq())
}
