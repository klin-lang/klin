// Enums (issue 072): a distinct named type over an integer base. They vanish in
// C emission (a typedef plus integer constants) — zero hidden cost.

enum Color { Red, Green, Blue }

// Optional base type and explicit values (like C23 `enum E : uint8_t`).
enum Status: u8 { Ok, Warn = 5, Err }

// Methods with a receiver work on enums, just like on structs.
fn (c: Color) name(): str {
    match c {
        Color.Red { return "red" }
        Color.Green { return "green" }
        Color.Blue { return "blue" }
    }
}

fn main() {
    let c: Color = Color.Green
    printf("color: %s\n", c.name())

    // Enums compare with `==` / `!=` and drive `match` (exhaustive: every
    // variant, or `else` for a leftover after `cast`).
    match c {
        Color.Red { printf("stop\n") }
        Color.Green { printf("go\n") }
        Color.Blue { printf("slow\n") }
    }

    // Explicit conversion to/from the integer base — never implicit.
    let s: Status = Status.Warn
    printf("status code: %d\n", cast(i32, s))
    let s2: Status = cast(Status, 5)
    if s2 == Status.Warn {
        printf("roundtrip ok\n")
    }

    // Enum as `[N]T` index when variants fit `0 .. N-1` (issue 126).
    let codes: [3]i32 = [10, 20, 30]
    printf("slot: %d\n", codes[c])
}
