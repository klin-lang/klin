# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/

# Directory created by dartdoc
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
*.info.json
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Klin compiler output — only under out/
/out/
examples/**/out/
# Registers generated from SVD by an example Makefile.
examples/**/stm32f411_regs.h
examples/**/stm32f411_regs.kl
# FFI example artifacts.
examples/ffi_add/*.o
examples/ffi_add/*.a
examples/ffi_add/libadd.a

# go-task cache (sources/generates checksums)
.task/

# Tools / IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
