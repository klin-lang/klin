module gd32v_sockets

import testing

fn test_version_is_one() {
    testing.assert_eq_i32(version(), 1)
}

fn test_err_ok_is_zero() {
    testing.assert_eq_i32(err_ok(), 0)
}

fn test_ipv4_pack() {
    let a: u32 = 192
    let b: u32 = 168
    let c: u32 = 1
    let d: u32 = 10
    testing.assert(ipv4(192, 168, 1, 10) == (a | (b << 8) | (c << 16) | (d << 24)))
}
