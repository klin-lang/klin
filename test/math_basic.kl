import math

fn main() {
    if math.abs(-2.0) == 2.0 {
        printf("abs_ok\n")
    }
    if math.sqrt(9.0) == 3.0 {
        printf("sqrt_ok\n")
    }
    if math.floor(3.7) == 3.0 {
        printf("floor_ok\n")
    }
    if math.ceil(3.2) == 4.0 {
        printf("ceil_ok\n")
    }
    if math.min(1.0, 2.0) == 1.0 {
        printf("min_ok\n")
    }
    if math.max(1.0, 2.0) == 2.0 {
        printf("max_ok\n")
    }
    if math.clamp(5.0, 0.0, 3.0) == 3.0 {
        printf("clamp_ok\n")
    }
    if math.min_i32(3, 1) == 1 {
        printf("min_i32_ok\n")
    }
    if math.max_i32(3, 1) == 3 {
        printf("max_i32_ok\n")
    }
    if math.clamp_i32(50_000, 0, 100_000) == 50_000 {
        printf("clamp_i32_mid_ok\n")
    }
    if math.clamp_i32(0 - 5, 0, 100_000) == 0 {
        printf("clamp_i32_lo_ok\n")
    }
    if math.clamp_i32(200_000, 0, 100_000) == 100_000 {
        printf("clamp_i32_hi_ok\n")
    }
    if math.clamp_f32(1.5, 0.0, 1.0) == 1.0 {
        printf("clamp_f32_ok\n")
    }
    if math.min_u8(9, 3) == 3 {
        printf("min_u8_ok\n")
    }
    if math.pow(2.0, 3.0) == 8.0 {
        printf("pow_ok\n")
    }
    if math.log(math.e()) == 1.0 {
        printf("log_ok\n")
    }
    if math.log10(1000.0) == 3.0 {
        printf("log10_ok\n")
    }
    if math.log2(8.0) == 3.0 {
        printf("log2_ok\n")
    }
    if math.sin(0.0) == 0.0 {
        printf("sin_ok\n")
    }
    if math.cos(0.0) == 1.0 {
        printf("cos_ok\n")
    }
    if math.pi() > 3.0 {
        printf("pi_ok\n")
    }
    if math.di() > 6.0 {
        printf("di_ok\n")
    }
    if math.e() > 2.0 {
        printf("e_ok\n")
    }
    if math.sqr(3.0) == 9.0 {
        printf("sqr_ok\n")
    }
    if math.cube(2.0) == 8.0 {
        printf("cube_ok\n")
    }
    if math.sqr_i32(3) == 9 {
        printf("sqr_i32_ok\n")
    }
    if math.cube_f32(2.0) == 8.0 {
        printf("cube_f32_ok\n")
    }
    if math.cbrt(8.0) == 2.0 {
        printf("cbrt_ok\n")
    }
    if math.cbrt(0.0 - 8.0) == 0.0 - 2.0 {
        printf("cbrt_neg_ok\n")
    }
    if math.root(16.0, 2.0) == 4.0 {
        printf("root_ok\n")
    }
    if math.sqrt_f32(9.0) == 3.0 {
        printf("sqrt_f32_ok\n")
    }
    let two_f32: f32 = 2.0
    if math.abs_f32(0.0 - two_f32) == 2.0 {
        printf("abs_f32_ok\n")
    }
    if math.pow_f32(2.0, 3.0) == 8.0 {
        printf("pow_f32_ok\n")
    }
    if math.sin_f32(0.0) == 0.0 {
        printf("sin_f32_ok\n")
    }
    if math.min_ieee_f32(1.0, 2.0) == 1.0 {
        printf("min_ieee_f32_ok\n")
    }
    if math.pi_f32() > 3.0 {
        printf("pi_f32_ok\n")
    }
    if math.di_f32() > 6.0 {
        printf("di_f32_ok\n")
    }
    if math.e_f32() > 2.0 {
        printf("e_f32_ok\n")
    }
    let { quot, rem } = math.div_i32(17, 5)
    if quot == 3 {
        if rem == 2 {
            printf("div_i32_ok\n")
        }
    }
    if math.div_u8(20, 6).quot == 3 {
        printf("div_u8_ok\n")
    }
}
