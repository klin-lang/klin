struct Token {
    kind: i32
    n: i32
}

struct Hold {
    buf: *mut [4]i32
    toks: *mut [2]Token
}

fn sum_tok(xs: []Token): i32 {
    let mut i = 0
    let mut acc = 0
    while i < xs.len {
        acc = acc + xs[i].kind + xs[i].n
        i = i + 1
    }
    return acc
}

fn first_byte(rows: [][]u8): i32 {
    return cast(i32, rows[0][0])
}

fn get_i32(p: *mut [4]i32): *mut [4]i32 {
    return p
}

fn get_tok(p: *mut [2]Token): *mut [2]Token {
    return p
}

fn pair(): [2]i32 {
    return [3, 4]
}

fn inc(x: i32): i32 {
    return x + 1
}

fn id_tok_ptrs(xs: []*mut [2]Token): i32 {
    return (*xs[0])[0].kind
}

let mut gbuf: [4]i32 = [1, 2, 3, 4]
let mut gp: *mut [4]i32 = &gbuf

let mut g2: [2][3]u8 = [[1, 2, 3], [4, 5, 6]]
let gp2: *mut [2][3]u8 = &g2

pub async fn bump(p: *mut [1]i32) {
    (*p)[0] = (*p)[0] + 1
}

fn main() {
    let mut xs: [4]i32 = [10, 20, 30, 40]
    let addr = cast(usize, &xs)
    let p = cast(*mut [4]i32, addr)
    let mut s = (*p)[:]
    let mut mid = (*p)[1:3]
    let tail = (*p)[2:]
    let head = (*p)[:2]
    s[0] = 7
    (*p)[1] = 8
    mid[0] = 9
    printf("%d %d %d %d\n", xs[0], xs[1], xs[2], xs[3])
    printf("%d %d\n", tail[0], head[1])

    let imm = cast(*[4]i32, addr)
    let view = (*imm)[:]
    let mut copied = view
    copied[0] = 5
    printf("%d %d\n", xs[0], view[0])

    let mut toks: [2]Token = [Token{ kind: 1, n: 10 }, Token{ kind: 2, n: 20 }]
    let tp = cast(*mut [2]Token, cast(usize, &toks))
    let mut ts = (*tp)[0:2]
    ts[0].n = 7
    printf("%d\n", sum_tok(ts))

    let row: [1]u8 = [65]
    let rows: [1][]u8 = [row[:]]
    let rp = cast(*mut [1][]u8, cast(usize, &rows))
    printf("%d\n", first_byte((*rp)[:]))

    let words: [2]str = ["hi", "yo"]
    let sp = cast(*[2]str, cast(usize, &words))
    printf("%s\n", (*sp)[:][1])

    let mut n: i32 = 6
    let slot: [1]*mut i32 = [&n]
    let pp = cast(*[1]*mut i32, cast(usize, &slot))
    *(*pp)[:][0] = 6
    printf("%d\n", n)

    let fs: [1]fn(i32): i32 = [inc]
    let fp = cast(*[1]fn(i32): i32, cast(usize, &fs))
    let f = (*fp)[:][0]
    printf("%d\n", f(4))

    let row2 = (*gp2)[1][:]
    printf("%d\n", cast(i32, row2[0]))

    let mut h = Hold{ buf: p, toks: tp }
    (*h.buf)[3] = 40
    printf("%d\n", (*h.toks)[1].kind)

    let q = get_i32(p)
    printf("%d\n", (*q)[:][2])

    (*gp)[0] = 11
    printf("%d\n", gbuf[0])

    let back = pair()
    let bp = &back
    printf("%d %d\n", (*bp)[0], (*bp)[1:][0])

    printf("%d\n", (*get_i32(p))[0])

    let ptrs: [1]*mut [2]Token = [tp]
    printf("%d\n", id_tok_ptrs(ptrs[:]))
    printf("%d\n", (*get_tok(tp))[1].kind)
    let ft: fn(*mut [2]Token): *mut [2]Token = get_tok
    printf("%d\n", (*ft(tp))[0].kind)
}
