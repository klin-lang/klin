const M: u32 = ~0
const NIB: u8 = ~0x0F
const MIN: i8 = -128

fn take(n: i64): i64 {
    return n
}

fn neg(): i64 {
    return -1
}

fn main() {
    let a: i64 = -1
    let b: i8 = -128
    let c: u8 = ~0
    let d: i32 = ~7
    let e: u32 = ~0
    printf("%lld %d %d %d %u %u %d %lld %lld\n", a, cast(i32, b), cast(i32, c), d, e, M, cast(i32, NIB), take(-1), neg())
}
