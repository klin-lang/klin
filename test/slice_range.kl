fn sum(xs: []i32): i32 {
    let mut i = 0
    let mut acc = 0
    while i < xs.len {
        acc = acc + xs[i]
        i = i + 1
    }
    return acc
}

fn bump(p: *mut i32, xs: []i32): []i32 {
    *p = *p + 1
    return xs
}

fn mark(p: *mut i32): i32 {
    *p = *p + 1
    return 1
}

fn main() {
    let mut xs: [5]i32 = [10, 20, 30, 40, 50]
    let mid = xs[1:4]
    printf("%d %d %d\n", mid.len, mid[0], sum(xs[0:2]))
    let tail = xs[3:]
    let head = xs[:2]
    printf("%d %d %d %d\n", tail.len, tail[0], head.len, head[1])
    let mut s = xs[:]
    let mut part = s[1:3]
    part[0] = 7
    xs[2:4][0] = 9
    printf("%d %d\n", xs[1], xs[2])

    let mut n = 0
    let t = bump(&n, xs[:])[1:]
    printf("%d %d %d\n", t.len, t[0], n)

    let rows: [2][4]u8 = [[1, 2, 3, 4], [5, 6, 7, 8]]
    let sub = rows[1][1:3]
    printf("%d %d\n", sub.len, sub[0])

    let bytes = b"hello"[1:4]
    printf("%d %d\n", bytes.len, bytes[0])

    let mut m = 0
    let once = xs[mark(&m):]
    printf("%d %d\n", once.len, m)

    let mut i = 0
    while bump(&n, xs[:])[1:].len > 0 && i < 2 {
        i = i + 1
    }
    printf("%d\n", n)
}
