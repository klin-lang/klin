struct Buf {
    data: [N]i32
}

const N: i64 = 4
const HEX: i32 = 0x4
const A: u8 = 'A'

fn sum(xs: [N]i32): i32 {
    return xs[0] + xs[3]
}

fn wide(xs: [HEX]i32): i32 {
    return xs.len
}

fn alen(xs: [A]u8): i32 {
    return xs.len
}

fn shadow(): i32 {
    let N: i32 = 1
    let buf: [N]i32
    return buf.len
}

fn main() {
    let xs: [N]i32 = [10, 20, 30, 40]
    let mut b: Buf
    b.data[0] = 7
    let ys: [HEX]i32 = [1, 2, 3, 4]
    let raw: [A]u8
    printf("%d %d %d %d %d %d\n", sum(xs), b.data[0], wide(ys), xs.len, alen(raw), shadow())
}
