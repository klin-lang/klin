fn pair(): [2]i32 {
    return [3, 4]
}

fn take(xs: [2]i32): i32 {
    return xs[0] + xs[1]
}

async fn work(xs: [2]i32, s: []i32) {
    let mut local: [2]i32 = [10, 20]
    let row: [1][2]i32 = [[4, 5]]
    let i = 1
    let a = pair()
    let p = pick true { local } { pair() }
    local[i] = local[i] + 1
    printf("%d\n", take(local) + take([1, 2]) + row[0][1] + p[1] + xs[0] + s[0] + a[0])
}

fn main() {}
