// Waveshare RP2350-LCD-0.96 — blink LCD backlight (GP25).
// Scaffold from `klin init waveshare-rp2350-lcd-096`.
// Run `klin get` once, then `make`.
import "github/klin-lang/machine_rp" machine
import "github/klin-lang/waveshare_rp2350_lcd_096" board

@[link("board/startup.s")]
@[link("board/image_def.S")]
fn main() {
  let bl = machine.pin_out_rp2350(board.lcd_bl())
  while true {
    bl.toggle()
    board.delay_ms(300)
  }
}
