// Waveshare ESP32-S3-RLCD-4.2 — clear / bar / text / flush.
// Scaffold from `klin init waveshare-esp32-s3-rlcd-42`.
// Run `klin get` once, then `make emit` / `make build` (needs ESP-IDF).
// After inserting 18650: connect USB-C once to wake battery protection.
import "github/klin-lang/waveshare_esp32_s3_rlcd_42" board

@[cexport, codename("klin_app_main")]
fn app_main_klin() {
  let mut e = board.init()
  if e != board.err_ok() {
    return
  }
  let mut fb: [15000]u8
  e = board.clear(fb[:])
  if e != board.err_ok() {
    return
  }
  e = board.rect(fb[:], 20, 40, 380, 80, 0)
  if e != board.err_ok() {
    return
  }
  let mut msg: [4]i32
  msg[0] = 75
  msg[1] = 76
  msg[2] = 73
  msg[3] = 78
  e = board.draw_text(fb[:], 24, 100, msg[:], board.color_black(), board.color_white())
  if e != board.err_ok() {
    return
  }
  e = board.flush(fb[:])
  if e != board.err_ok() {
    return
  }
  while true {
    let _mv = board.battery_mv()
    let mut i: i32 = 0
    while i < 20000000 {
      i = i + 1
    }
  }
}

fn main() {
  app_main_klin()
}
