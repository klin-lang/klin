module gd32v_websocket

import testing

fn test_version_is_one() {
    testing.assert_eq_i32(version(), 1)
}

fn test_err_ok_is_zero() {
    testing.assert_eq_i32(err_ok(), 0)
}

fn test_opcodes() {
    testing.assert_eq_i32(opcode_text(), 1)
    testing.assert_eq_i32(opcode_bin(), 2)
}

fn test_connect_send_recv_text_host_stub() {
    let mut msg: [4]u8
    let mut out: [16]u8
    let mut n: i32
    msg[0] = 112
    msg[1] = 105
    msg[2] = 110
    msg[3] = 103
    testing.assert_eq_i32(connect("ws://127.0.0.1/echo"), 0)
    testing.assert(connected())
    testing.assert_eq_i32(send_text(cast(*u8, &msg[0]), 4), 0)
    n = recv(cast(*mut u8, &out[0]), 16)
    testing.assert_eq_i32(n, 4)
    testing.assert_eq_i32(last_opcode(), opcode_text())
    testing.assert_eq_i32(disconnect(), 0)
    testing.assert(connected() == false)
}

fn test_send_bin_host_stub() {
    let mut msg: [2]u8
    let mut out: [8]u8
    msg[0] = 1
    msg[1] = 2
    testing.assert_eq_i32(connect("ws://example/"), 0)
    testing.assert_eq_i32(send_bin(cast(*u8, &msg[0]), 2), 0)
    testing.assert_eq_i32(recv(cast(*mut u8, &out[0]), 8), 2)
    testing.assert_eq_i32(last_opcode(), opcode_bin())
    testing.assert_eq_i32(disconnect(), 0)
}

fn test_connect_rejects_wss_and_bad_uri() {
    testing.assert_eq_i32(connect("wss://secure/"), 0 - 1)
    testing.assert_eq_i32(connect("http://nope/"), 0 - 1)
}

fn test_send_without_connect() {
    let mut msg: [1]u8
    msg[0] = 0
    testing.assert_eq_i32(send_text(cast(*u8, &msg[0]), 1), 0 - 1)
}
