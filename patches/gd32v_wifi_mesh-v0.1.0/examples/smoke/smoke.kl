/// Host smoke: Wi‑Fi Mesh-Smart stubs (no SDK).
import "../../gd32v_wifi_mesh" mesh

fn main() {
    let mut e = mesh.init()
    if e != mesh.err_ok() {
        return
    }
    e = mesh.config_rootap("router-ssid", "router-pass")
    if e != mesh.err_ok() {
        return
    }
    if mesh.joined() == false {
        return
    }
    let _s = mesh.softap_stop()
}
