+++ b/examples/ibeacon/ibeacon.kl
@@ -0,0 +1,22 @@
+// GD32VW553 BLE Apple iBeacon — needs GD32VW55x_WiFi_BLE_SDK on the include/link path.
+// License: https://developer.apple.com/ibeacon/
+import "../../gd32v_ble" ble
+
+fn main() {
+    let mut uuid: [16]u8
+    let mut i = 0
+    while i < 16 {
+        uuid[i] = cast(u8, i + 1)
+        i = i + 1
+    }
+
+    let mut e = ble.init()
+    if e != ble.err_ok() {
+        return
+    }
+    // major/minor big-endian on air; measured_pwr = RSSI at 1 m (signed int8).
+    e = ble.ibeacon_advertise(cast(*u8, &uuid[0]), 0x1111, 0x2222, 0 - 61)
+    if e != ble.err_ok() {
+        return
+    }
+}
