+
+fn test_ibeacon_advertise_host_stub() {
+    let mut uuid: [16]u8
+    let mut i = 0
+    testing.assert_eq_i32(init(), 0)
+    while i < 16 {
+        uuid[i] = cast(u8, i)
+        i = i + 1
+    }
+    testing.assert_eq_i32(
+        ibeacon_advertise(cast(*u8, &uuid[0]), 0x1111, 0x2222, 0 - 61),
+        0
+    )
+    testing.assert_eq_i32(advertising(), 1)
+    testing.assert_eq_i32(wait_connected(0), 0 - 1)
+    testing.assert_eq_i32(connected(), 0)
+    testing.assert_eq_i32(stop_advertise(), 0)
+    testing.assert_eq_i32(advertising(), 0)
+    testing.assert_eq_i32(stop(), 0)
+}
+
+fn test_ibeacon_rejects_bad_range() {
+    let mut uuid: [16]u8
+    testing.assert_eq_i32(init(), 0)
+    testing.assert_eq_i32(
+        ibeacon_advertise(cast(*u8, &uuid[0]), 0 - 1, 0, 0 - 59),
+        0 - 1
+    )
+    testing.assert_eq_i32(
+        ibeacon_advertise(cast(*u8, &uuid[0]), 0, 70000, 0 - 59),
+        0 - 1
+    )
+    testing.assert_eq_i32(
+        ibeacon_advertise(cast(*u8, &uuid[0]), 1, 2, 200),
+        0 - 1
+    )
