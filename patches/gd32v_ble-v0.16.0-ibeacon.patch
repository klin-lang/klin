+/// Non-connectable Apple iBeacon (company `0x004C`, type `0x02 0x15`).
+/// `uuid16` = 16-byte proximity UUID; `major`/`minor` `0..=65535`;
+/// `measured_pwr` = calibrated RSSI at 1 m as signed int8 (`-128..=127`).
+/// Stops any prior advertise. `wait_connected` fails while iBeacon is active.
+pub fn ibeacon_advertise(
