+#define KLIN_GD32V_BLE_IBEACON_COMPANY_ID 0x004Cu
+#define KLIN_GD32V_BLE_IBEACON_DATA_LEN   23
+
+static void klin_gd32v_ble_ibeacon_fill(
+    const unsigned char *uuid16, int major, int minor, int measured_pwr)
+{
+    s_ibeacon_payload[0] = 0x02;
+    s_ibeacon_payload[1] = 0x15;
+    memcpy(s_ibeacon_payload + 2, uuid16, 16);
+    s_ibeacon_payload[18] = (unsigned char)((major >> 8) & 0xff);
+    s_ibeacon_payload[19] = (unsigned char)(major & 0xff);
+    s_ibeacon_payload[20] = (unsigned char)((minor >> 8) & 0xff);
+    s_ibeacon_payload[21] = (unsigned char)(minor & 0xff);
+    s_ibeacon_payload[22] = (unsigned char)(measured_pwr & 0xff);
+}
+
+static void klin_gd32v_ble_ibeacon_start_data(uint8_t adv_idx)
+{
+    ble_adv_data_set_t adv;
+    ble_adv_data_t adv_data;
+    ble_adv_data_manuf_data_t manuf_data;
+
+    memset(&adv, 0, sizeof(adv));
+    memset(&adv_data, 0, sizeof(adv_data));
+    memset(&manuf_data, 0, sizeof(manuf_data));
+
+    manuf_data.company_id = KLIN_GD32V_BLE_IBEACON_COMPANY_ID;
+    manuf_data.data_len = KLIN_GD32V_BLE_IBEACON_DATA_LEN;
+    manuf_data.p_data = s_ibeacon_payload;
+
+    adv_data.flags = BLE_GAP_ADV_FLAG_LE_ONLY_GENERAL_DISC_MODE;
+    adv_data.p_manuf_specific_data = &manuf_data;
+
+    adv.data_force = false;
+    adv.data.p_data_enc = &adv_data;
+
+    (void)ble_adv_start(adv_idx, &adv, NULL, NULL);
+}
+
+static void klin_gd32v_ble_ibeacon_evt(ble_adv_evt_t adv_evt, void *p_data, void *p_context)
+{
+    ble_adv_state_chg_t *p_chg;
+    int old_state;
+
+    (void)p_context;
+    if (adv_evt != BLE_ADV_EVT_STATE_CHG || p_data == NULL) {
+        return;
+    }
+    p_chg = (ble_adv_state_chg_t *)p_data;
+    old_state = s_ibeacon_adv_state;
+    s_ibeacon_adv_state = (int)p_chg->state;
+    if ((p_chg->state == BLE_ADV_STATE_CREATE)
+        && (old_state == (int)BLE_ADV_STATE_CREATING)) {
+        s_ibeacon_adv_idx = p_chg->adv_idx;
+        klin_gd32v_ble_ibeacon_start_data(p_chg->adv_idx);
+    }
+}
+
+int klin_gd32v_ble_ibeacon_advertise(
+    const unsigned char *uuid16, int major, int minor, int measured_pwr)
+{
+    ble_adv_param_t adv_param;
+
+    if (!s_inited || uuid16 == NULL) {
+        return -1;
+    }
+    if (major < 0 || major > 65535 || minor < 0 || minor > 65535) {
+        return -1;
+    }
+    if (measured_pwr < -128 || measured_pwr > 127) {
+        return -1;
+    }
+
+    (void)klin_gd32v_ble_stop_advertise();
+
+    klin_gd32v_ble_ibeacon_fill(uuid16, major, minor, measured_pwr);
+
+    memset(&adv_param, 0, sizeof(adv_param));
+    adv_param.param.own_addr_type = s_own_addr_type;
+    adv_param.param.type = BLE_GAP_ADV_TYPE_LEGACY;
+    adv_param.param.prop = BLE_GAP_ADV_PROP_NON_CONN_NON_SCAN;
+    adv_param.param.filter_pol = BLE_GAP_ADV_ALLOW_SCAN_ANY_CON_ANY;
+    adv_param.param.disc_mode = BLE_GAP_ADV_MODE_GEN_DISC;
+    adv_param.param.primary_phy = BLE_GAP_PHY_1MBPS;
+    adv_param.param.ch_map = 0x07;
+    adv_param.param.adv_intv_min = APP_ADV_INT_MIN;
+    adv_param.param.adv_intv_max = APP_ADV_INT_MAX;
+
+    s_ibeacon_adv_state = (int)BLE_ADV_STATE_IDLE;
+    s_ibeacon_adv_idx = 0xFF;
+    if (ble_adv_create(&adv_param, klin_gd32v_ble_ibeacon_evt, NULL) != BLE_ERR_NO_ERROR) {
+        return -1;
+    }
+    s_ibeacon = 1;
+    s_advertising = 1;
+    s_connected = 0;
+    return 0;
+}
