new file mode 100644
index 0000000..05ae5b8
--- /dev/null
+++ b/examples/uart_leonardo/uart.kl
@@ -0,0 +1,32 @@
+// Leonardo HardwareSerial1: TX=PD3 (D1), RX=PD2 (D0). F_CPU = 16_000_000.
+// USB CDC Serial is not this USART.
+import "../../machine_avr" machine
+
+fn main() {
+    let u = machine.uart_out_32u4(
+        machine.Port32U4.D,
+        3,
+        machine.Port32U4.D,
+        2,
+        16000000,
+        9600
+    )
+    let mut msg: [6]u8
+    msg[0] = 104
+    msg[1] = 101
+    msg[2] = 108
+    msg[3] = 108
+    msg[4] = 111
+    msg[5] = 10
+    while true {
+        u.write(msg)
+        if u.any() {
+            let b = u.read_u8()
+            u.write_u8(b)
+        }
+        let mut i: i32 = 0
+        while i < 20000 {
+            i = i + 1
+        }
+    }
+}
diff --git a/machine_avr/adc.kl b/machine_avr/adc.kl
index 3f28acf..fa8db9a 100644
--- a/machine_avr/adc.kl
+++ b/machine_avr/adc.kl
@@ -65,3 +65,27 @@ pub fn (a: Adc) read_u16(): i32 {
 pub fn (a: Adc) deinit() {
     *(a.adcsra) = 0
 }
+
+/// ATmega32U4 ADC. Leonardo A0 = PF7 channel 7: `adc_out_32u4(Port32U4.F, 7, 7)`.
+pub fn adc_out_32u4(port: Port32U4, num: i32, channel: i32): Adc {
+    let p = pin_in_32u4(port, num)
+    if p.mask == 0 {
+    }
+    let mut ch = channel
+    if ch < 0 {
+        ch = 0
+    }
+    if ch > 8 {
+        ch = 8
+    }
+
+    let admux = cast(*mut volatile u8, 0x7C)
+    let adcsra = cast(*mut volatile u8, 0x7A)
+    let adcl = cast(*mut volatile u8, 0x78)
+    let adch = cast(*mut volatile u8, 0x79)
+
+    *admux = i32_to_u8(64 | (ch & 15))
+    *adcsra = 135
+
+    return Adc{ admux: admux, adcsra: adcsra, adcl: adcl, adch: adch, channel: ch }
+}
diff --git a/machine_avr/i2c.kl b/machine_avr/i2c.kl
index dfc90c3..f19cd0b 100644
--- a/machine_avr/i2c.kl
+++ b/machine_avr/i2c.kl
@@ -138,3 +138,29 @@ pub fn (bus: I2c) write_readfrom_into(addr: i32, w: i32, buf: []u8) {
 pub fn (bus: I2c) deinit() {
     *(bus.twcr) = 0
 }
+
+/// ATmega32U4 TWI. Leonardo: SDA=PD1 (D2), SCL=PD0 (D3).
+pub fn i2c_out_32u4(
+    sda_port: Port32U4,
+    sda_num: i32,
+    scl_port: Port32U4,
+    scl_num: i32,
+    i2c_clk_hz: i32,
+    freq_hz: i32
+): I2c {
+    let sda = pin_in_32u4(sda_port, sda_num)
+    let scl = pin_in_32u4(scl_port, scl_num)
+    sda.high()
+    scl.high()
+
+    let twbr = cast(*mut volatile u8, 0xB8)
+    let twsr = cast(*mut volatile u8, 0xB9)
+    let twdr = cast(*mut volatile u8, 0xBB)
+    let twcr = cast(*mut volatile u8, 0xBC)
+
+    *twsr = 0
+    *twbr = i32_to_u8(i2c_twbr(i2c_clk_hz, freq_hz))
+    *twcr = 4
+
+    return I2c{ twbr: twbr, twsr: twsr, twdr: twdr, twcr: twcr }
+}
diff --git a/machine_avr/pin.kl b/machine_avr/pin.kl
index f2d9381..83591bf 100644
--- a/machine_avr/pin.kl
+++ b/machine_avr/pin.kl
@@ -1,5 +1,6 @@
-// megaAVR Pin (MMIO). ATmega328P + ATmega2560 — classic PORTx/DDRx/PINx.
-// Memory addresses match avr-libc (iom328p / iomxx0_1). No hidden init.
+// megaAVR Pin (MMIO). ATmega328P + ATmega2560 + ATmega32U4 —
+// classic PORTx/DDRx/PINx. Memory addresses match avr-libc
+// (iom328p / iomxx0_1 / iom32u4). No hidden init.
 module machine_avr
 
 // ATmega328P ports (Uno / Nano / Pro Mini).
@@ -24,6 +25,16 @@ pub enum Port2560: i32 {
     L = 10
 }
 
+// ATmega32U4 ports (Leonardo / Micro / Pro Micro).
+// Data-space PINB=0x23 … PINF=0x2F (avr-libc IO + 0x20).
+pub enum Port32U4: i32 {
+    B = 0
+    C = 1
+    D = 2
+    E = 3
+    F = 4
+}
+
 pub struct Pin {
     port: *mut volatile u8
     pin: *mut volatile u8
@@ -56,6 +67,11 @@ fn pin_base_2560(port: Port2560): i32 {
     return 0x100 + (p - 7) * 3
 }
 
+// PIN register base for 32U4: B@0x23 … F@0x2F.
+fn pin_base_32u4(port: Port32U4): i32 {
+    return 0x23 + cast(i32, port) * 3
+}
+
 fn make_pin(base: i32, num: i32, as_output: i32): Pin {
     let mask = pin_bit_mask(num)
     let pin = cast(*mut volatile u8, base)
@@ -90,6 +106,17 @@ pub fn pin_in_2560(port: Port2560, num: i32): Pin {
     return make_pin(pin_base_2560(port), num, 0)
 }
 
+// ATmega32U4 — configure port/num as output.
+// Leonardo LED D13 = Port32U4.C, 7.
+pub fn pin_out_32u4(port: Port32U4, num: i32): Pin {
+    return make_pin(pin_base_32u4(port), num, 1)
+}
+
+// ATmega32U4 — configure port/num as input.
+pub fn pin_in_32u4(port: Port32U4, num: i32): Pin {
+    return make_pin(pin_base_32u4(port), num, 0)
+}
+
 pub fn (p: Pin) high() {
     *(p.port) = *(p.port) | p.mask
 }
