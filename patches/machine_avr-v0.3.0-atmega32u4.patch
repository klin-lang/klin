diff --git a/examples/adc_leonardo/adc.kl b/examples/adc_leonardo/adc.kl
new file mode 100644
index 0000000..27fc563
--- /dev/null
+++ b/examples/adc_leonardo/adc.kl
@@ -0,0 +1,17 @@
+// Leonardo A0 = PF7 / ADC7.
+import "../../machine_avr" machine
+
+fn main() {
+    let adc = machine.adc_out_32u4(machine.Port32U4.F, 7, 7)
+    let mut v: i32 = 0
+    while true {
+        v = adc.read_u16()
+        let mut i: i32 = 0
+        while i < 20000 {
+            i = i + 1
+        }
+        if v < 0 {
+            break
+        }
+    }
+}
