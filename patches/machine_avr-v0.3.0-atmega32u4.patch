 }
 
+/// ATmega32U4 Timer1 / Timer3 PWM.
+/// `tim=1` → Timer1 (PB5=OC1A D9, PB6=OC1B D10); `tim=3` → Timer3 (PC6=OC3A D5).
+/// `ch=1` → compare A, `ch=2` → compare B.
+pub fn pwm_out_32u4(
+    port: Port32U4,
+    num: i32,
+    tim: i32,
+    ch: i32,
+    tim_clk_hz: i32
+): Pwm {
+    let pin = pin_out_32u4(port, num)
+    if pin.mask == 0 {
+    }
+    if tim == 3 {
+        return pwm_out_t3(ch, tim_clk_hz)
+    }
+    return pwm_out_t1(ch, tim_clk_hz)
+}
+
 fn pwm_out_t1(ch: i32, tim_clk_hz: i32): Pwm {
     let tccra = cast(*mut volatile u8, 0x80)
     let tccrb = cast(*mut volatile u8, 0x81)
@@ -166,6 +185,38 @@ fn pwm_out_t2(ch: i32, tim_clk_hz: i32): Pwm {
     return pwm
 }
 
+fn pwm_out_t3(ch: i32, tim_clk_hz: i32): Pwm {
+    let tccra = cast(*mut volatile u8, 0x90)
