module rotary_encoder
import testing

fn test_version() {
    testing.assert_eq_i32(version(), 1)
}

fn test_channels() {
    testing.assert_eq_i32(ch_a(), 0)
    testing.assert_eq_i32(ch_b(), 1)
    testing.assert_eq_i32(ch_sw(), 2)
    testing.assert_eq_i32(default_btn_thresh(), 3)
}

fn test_ab_code() {
    testing.assert_eq_i32(ab_code(0, 0), 0)
    testing.assert_eq_i32(ab_code(0, 1), 1)
    testing.assert_eq_i32(ab_code(1, 0), 2)
    testing.assert_eq_i32(ab_code(1, 1), 3)
}

fn test_step_cw_cycle() {
    // 00 → 01 → 11 → 10 → 00
    testing.assert_eq_i32(step(0, 1), 1)
    testing.assert_eq_i32(step(1, 3), 1)
    testing.assert_eq_i32(step(3, 2), 1)
    testing.assert_eq_i32(step(2, 0), 1)
}

fn test_step_ccw_cycle() {
    // 00 → 10 → 11 → 01 → 00
    testing.assert_eq_i32(step(0, 2), -1)
    testing.assert_eq_i32(step(2, 3), -1)
    testing.assert_eq_i32(step(3, 1), -1)
    testing.assert_eq_i32(step(1, 0), -1)
}

fn test_step_idle_and_illegal() {
    testing.assert_eq_i32(step(0, 0), 0)
    testing.assert_eq_i32(step(1, 1), 0)
    testing.assert_eq_i32(step(0, 3), 0)
    testing.assert_eq_i32(step(3, 0), 0)
}
