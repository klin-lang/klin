/// SPI1 + GPIO adapters for klin_st7735 + klin_xpt2046 on Black Pill F411CE.
module app
import "github/klin-lang/machine_stm32" machine
import "github/klin-lang/klin_st7735" lcd
import klin_xpt2046 touch

struct Bus {
    spi: machine.Spi
    lcd_cs: machine.Pin
    t_cs: machine.Pin
    dc: machine.Pin
    rst: machine.Pin
    sd_cs: machine.Pin
}

fn busy_ms(ms: i32) {
    let mut n = ms * 4000
    while n > 0 {
        n = n - 1
    }
}

fn spi_byte(bus: *mut Bus, b: i32): i32 {
    let s = (*bus).spi
    return s.write_read_u8(b)
}

fn tft_cmd(ctx: *mut u8, b: i32) {
    let bus = cast(*mut Bus, ctx)
    (*bus).dc.low()
    (*bus).lcd_cs.low()
    spi_byte(bus, b)
    (*bus).lcd_cs.high()
}

fn tft_data(ctx: *mut u8, b: i32) {
    let bus = cast(*mut Bus, ctx)
    (*bus).dc.high()
    (*bus).lcd_cs.low()
    spi_byte(bus, b)
    (*bus).lcd_cs.high()
}

fn tft_delay(ctx: *mut u8, ms: i32) {
    busy_ms(ms)
}

fn tft_rst(ctx: *mut u8) {
    let bus = cast(*mut Bus, ctx)
    (*bus).rst.high()
    busy_ms(10)
    (*bus).rst.low()
    busy_ms(10)
    (*bus).rst.high()
    busy_ms(120)
}

/// CS low, command byte, 16-bit MISO (MSB first), CS high.
fn touch_xfer(ctx: *mut u8, cmd: i32): i32 {
    let bus = cast(*mut Bus, ctx)
    (*bus).t_cs.low()
    spi_byte(bus, cmd & 255)
    let hi = spi_byte(bus, 0)
    let lo = spi_byte(bus, 0)
    (*bus).t_cs.high()
    return ((hi & 255) << 8) | (lo & 255)
}

fn bus_spi1(): Bus {
    return Bus{
        spi: machine.spi_out(
            1,
            machine.Port.A, 5, 5,
            machine.Port.A, 6, 5,
            machine.Port.A, 7, 5,
            16000000,
            2000000,
            0
        ),
        lcd_cs: machine.pin_out(machine.Port.B, 12),
        t_cs: machine.pin_out(machine.Port.B, 10),
        dc: machine.pin_out(machine.Port.B, 0),
        rst: machine.pin_out(machine.Port.B, 1),
        sd_cs: machine.pin_out(machine.Port.B, 15)
    }
}

fn attach_tft(bus: *mut Bus): lcd.Lcd {
    return lcd.attach(lcd.Wire{
        ctx: cast(*mut u8, bus),
        cmd: tft_cmd,
        data: tft_data,
        delay_ms: tft_delay,
        rst: tft_rst
    }, lcd.Tab.black)
}

fn attach_touch(bus: *mut Bus): touch.Dev {
    return touch.attach(touch.Wire{
        ctx: cast(*mut u8, bus),
        xfer: touch_xfer
    })
}
