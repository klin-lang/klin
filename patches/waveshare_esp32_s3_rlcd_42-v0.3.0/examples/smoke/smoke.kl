// emit-c smoke (no ESP-IDF). Uses stubs/bus_idf.c via package @[link] override… 
// Package links bus_idf.c from the module dir; for host smoke we emit with -I stubs.
import "../../waveshare_esp32_s3_rlcd_42" board

fn main() {
  let mut e = board.init()
  if e != board.err_ok() {
    return
  }
  if board.fb_len() != 15000 {
    return
  }
  if board.width() != 400 {
    return
  }
  if board.lcd_sck() != 11 {
    return
  }
  let mut fb: [15000]u8
  e = board.clear(fb[:])
  if e != board.err_ok() {
    return
  }
  e = board.rect(fb[:], 10, 10, 50, 40, 0)
  if e != board.err_ok() {
    return
  }
  let mut ab: [2]i32
  ab[0] = 65
  ab[1] = 66
  e = board.draw_text(fb[:], 0, 0, ab[:], board.color_black(), board.color_white())
  if e != board.err_ok() {
    return
  }
  e = board.flush(fb[:])
  if e != board.err_ok() {
    return
  }
  let _mv = board.battery_mv()
  let _v = board.version()
}
