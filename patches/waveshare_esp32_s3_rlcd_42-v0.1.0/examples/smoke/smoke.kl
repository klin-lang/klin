// emit-c smoke (no ESP-IDF).
import "../../waveshare_esp32_s3_rlcd_42" board

fn main() {
  let mut e = board.init()
  if e != board.err_ok() {
    return
  }
  if board.fb_len() != 15000 {
    return
  }
  if board.width() != 400 {
    return
  }
  if board.lcd_sck() != 11 {
    return
  }
  let mut fb: [15000]u8
  e = board.clear(cast(*mut u8, &fb[0]), 15000)
  if e != board.err_ok() {
    return
  }
  e = board.rect(cast(*mut u8, &fb[0]), 15000, 10, 10, 50, 40, 0)
  if e != board.err_ok() {
    return
  }
  e = board.flush(cast(*u8, &fb[0]), 15000)
  if e != board.err_ok() {
    return
  }
  let _mv = board.battery_mv()
  let _v = board.version()
}
