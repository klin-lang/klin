fn font_k(col: i32): i32 {
    return pick5(col, 0x7F, 0x08, 0x14, 0x22, 0x41)
}

fn font_l(col: i32): i32 {
    return pick5(col, 0x7F, 0x40, 0x40, 0x40, 0x40)
