/// Compact 5×7 glyphs (5 columns × 7 rows). Column bit0 = top pixel.
/// Covers space, digits, A–Z, and `.:-+%`. Unknown → filled box.
module klin_st7305

pub fn font_char_w(): i32 {
    return 6
}

pub fn font_char_h(): i32 {
    return 8
}

/// One column (0..=4) of glyph for ASCII `ch`. Bits 0..=6 = rows.
pub fn font5x7_col(ch: i32, col: i32): i32 {
    let mut c = ch
    if c >= 97 {
        if c <= 122 {
            c = c - 32
        }
    }
    if col < 0 {
        return 0
    }
    if col > 4 {
        return 0
    }
    let bits = match c {
        32 { 0 }
        37 { font_pct(col) }
        43 { font_plus(col) }
        45 { font_minus(col) }
        46 { font_dot(col) }
        48 { font_0(col) }
        49 { font_1(col) }
        50 { font_2(col) }
        51 { font_3(col) }
        52 { font_4(col) }
        53 { font_5(col) }
        54 { font_6(col) }
        55 { font_7(col) }
        56 { font_8(col) }
        57 { font_9(col) }
        58 { font_colon(col) }
        65 { font_a(col) }
        66 { font_b(col) }
        67 { font_c(col) }
        68 { font_d(col) }
        69 { font_e(col) }
        70 { font_f(col) }
        71 { font_g(col) }
        72 { font_h(col) }
        73 { font_i(col) }
        74 { font_j(col) }
        75 { font_k(col) }
        76 { font_l(col) }
        77 { font_m(col) }
        78 { font_n(col) }
        79 { font_o(col) }
        80 { font_p(col) }
        81 { font_q(col) }
        82 { font_r(col) }
        83 { font_s(col) }
        84 { font_t(col) }
        85 { font_u(col) }
        86 { font_v(col) }
        87 { font_w(col) }
        88 { font_x(col) }
        89 { font_y(col) }
        90 { font_z(col) }
        else { font_box(col) }
    }
    return bits
}

fn pick5(col: i32, a: i32, b: i32, c: i32, d: i32, e: i32): i32 {
    let v = match col {
        0 { a }
        1 { b }
        2 { c }
        3 { d }
        else { e }
    }
    return v
}

fn font_box(col: i32): i32 {
    return pick5(col, 0x7F, 0x41, 0x41, 0x41, 0x7F)
}

fn font_dot(col: i32): i32 {
    return pick5(col, 0x00, 0x00, 0x60, 0x60, 0x00)
}

fn font_colon(col: i32): i32 {
    return pick5(col, 0x00, 0x00, 0x6C, 0x6C, 0x00)
}

fn font_minus(col: i32): i32 {
    return pick5(col, 0x08, 0x08, 0x08, 0x08, 0x08)
}

fn font_plus(col: i32): i32 {
    return pick5(col, 0x08, 0x08, 0x3E, 0x08, 0x08)
}

fn font_pct(col: i32): i32 {
    return pick5(col, 0x63, 0x13, 0x08, 0x64, 0x63)
}

fn font_0(col: i32): i32 {
    return pick5(col, 0x3E, 0x51, 0x49, 0x45, 0x3E)
}

fn font_1(col: i32): i32 {
    return pick5(col, 0x00, 0x42, 0x7F, 0x40, 0x00)
}

fn font_2(col: i32): i32 {
    return pick5(col, 0x42, 0x61, 0x51, 0x49, 0x46)
}

fn font_3(col: i32): i32 {
    return pick5(col, 0x21, 0x41, 0x45, 0x4B, 0x31)
}

