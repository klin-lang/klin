}

fn font_6(col: i32): i32 {
    return pick5(col, 0x3C, 0x4A, 0x49, 0x49, 0x30)
}

fn font_7(col: i32): i32 {
    return pick5(col, 0x01, 0x71, 0x09, 0x05, 0x03)
}

fn font_8(col: i32): i32 {
    return pick5(col, 0x36, 0x49, 0x49, 0x49, 0x36)
}

fn font_9(col: i32): i32 {
    return pick5(col, 0x06, 0x49, 0x49, 0x29, 0x1E)
}

