module app
import klin_pcf85063 rtc

@[cimport, codename("memcpy")]
fn memcpy(dst: *mut u8, src: *u8, n: i32): *mut u8

struct Rec {
    mem: [16]u8
}

fn mock_write(ctx: *mut u8, addr7: i32, data: *u8, len: i32): i32 {
    let r = cast(*mut Rec, ctx)
    let _a = addr7
    if len >= 1 {
        let mut tmp: [8]u8
        let n = pick len < 8 { len } { 8 }
        let _cp1 = memcpy(cast(*mut u8, &tmp[0]), data, n)
        let reg = cast(i32, tmp[0])
        let mut i: i32 = 1
        while i < n {
            if reg + i - 1 < 16 {
                (*r).mem[reg + i - 1] = tmp[i]
            }
            i = i + 1
        }
    }
    return 0
}

fn mock_read(ctx: *mut u8, addr7: i32, buf: *mut u8, len: i32): i32 {
    let _c = ctx
    let _a = addr7
    let _b = buf
    let _l = len
    return 1
}

fn mock_write_read(ctx: *mut u8, addr7: i32, wdata: *u8, wlen: i32, rbuf: *mut u8, rlen: i32): i32 {
    let r = cast(*mut Rec, ctx)
    let _a = addr7
    if wlen < 1 {
        return 1
    }
    let mut regb: [1]u8
    let _cp2 = memcpy(cast(*mut u8, &regb[0]), wdata, 1)
    let reg = cast(i32, regb[0])
    let mut out: [8]u8
    let mut i: i32 = 0
    while i < rlen {
        if i < 8 {
            if reg + i < 16 {
                out[i] = (*r).mem[reg + i]
            } else {
                out[i] = cast(u8, 0)
            }
        }
        i = i + 1
    }
    let n = pick rlen < 8 { rlen } { 8 }
    let _cp3 = memcpy(rbuf, cast(*u8, &out[0]), n)
    return 0
}

fn mock_delay(ctx: *mut u8, ms: i32) {
    let _c = ctx
    let _m = ms
}

fn main() {
    printf("klin_pcf85063 %d\n", rtc.version())
    printf("addr 0x%x\n", rtc.addr7())
    let mut rec = Rec{
        mem: [cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0)]
    }
    let wire = rtc.Wire{
        ctx: cast(*mut u8, &rec),
        write: mock_write,
        read: mock_read,
        write_read: mock_write_read,
        delay_ms: mock_delay
    }
    let dev = rtc.attach(wire)
    let e0 = dev.set_time(1, 2, 3, 4, 5, 6, 26)
    let mut sec: i32 = 0
    let mut min: i32 = 0
    let mut hour: i32 = 0
    let mut day: i32 = 0
    let mut wday: i32 = 0
    let mut month: i32 = 0
    let mut year: i32 = 0
    let e1 = dev.read_time(&sec, &min, &hour, &day, &wday, &month, &year)
    printf("set=%d read=%d %02d:%02d:%02d %d/%d/%d wday=%d\n", e0, e1, hour, min, sec, day, month, year, wday)
}
