module klin_pcf85063
import testing

@[cimport, codename("memcpy")]
fn memcpy(dst: *mut u8, src: *u8, n: i32): *mut u8

struct Rec {
    nwrite: i32
    nwr: i32
    last_addr: i32
    mem: [16]u8
    fail: i32
    last_wlen: i32
}

fn rec_write(ctx: *mut u8, addr7: i32, data: *u8, len: i32): i32 {
    let r = cast(*mut Rec, ctx)
    (*r).nwrite = (*r).nwrite + 1
    (*r).last_addr = addr7
    (*r).last_wlen = len
    if (*r).fail != 0 {
        return 1
    }
    if len >= 1 {
        let mut tmp: [8]u8
        let n = pick len < 8 { len } { 8 }
        let _cp1 = memcpy(cast(*mut u8, &tmp[0]), data, n)
        let reg = cast(i32, tmp[0])
        let mut i: i32 = 1
        while i < n {
            if reg + i - 1 < 16 {
                (*r).mem[reg + i - 1] = tmp[i]
            }
            i = i + 1
        }
    }
    return 0
}

fn rec_read(ctx: *mut u8, addr7: i32, buf: *mut u8, len: i32): i32 {
    let _c = ctx
    let _a = addr7
    let _b = buf
    let _l = len
    return 1
}

fn rec_write_read(ctx: *mut u8, addr7: i32, wdata: *u8, wlen: i32, rbuf: *mut u8, rlen: i32): i32 {
    let r = cast(*mut Rec, ctx)
    (*r).nwr = (*r).nwr + 1
    (*r).last_addr = addr7
    if (*r).fail != 0 {
        return 1
    }
    if wlen < 1 {
        return 1
    }
    let mut regb: [1]u8
    let _cp2 = memcpy(cast(*mut u8, &regb[0]), wdata, 1)
    let reg = cast(i32, regb[0])
    let mut out: [8]u8
    let mut i: i32 = 0
    while i < rlen {
        if i < 8 {
            if reg + i < 16 {
                out[i] = (*r).mem[reg + i]
            } else {
                out[i] = cast(u8, 0)
            }
        }
        i = i + 1
    }
    let n = pick rlen < 8 { rlen } { 8 }
    let _cp3 = memcpy(rbuf, cast(*u8, &out[0]), n)
    return 0
}

fn rec_delay(ctx: *mut u8, ms: i32) {
    let _c = ctx
    let _m = ms
}

fn mock_wire(rec: *mut Rec): Wire {
    return Wire{
        ctx: cast(*mut u8, rec),
        write: rec_write,
        read: rec_read,
        write_read: rec_write_read,
        delay_ms: rec_delay
    }
}

fn test_version() {
    testing.assert_eq_i32(version(), 1)
}

fn test_addr() {
    testing.assert_eq_i32(addr7(), 0x51)
    testing.assert_eq_i32(reg_seconds(), 0x04)
}

fn test_bcd() {
    testing.assert_eq_i32(bin_to_bcd(0), 0x00)
    testing.assert_eq_i32(bin_to_bcd(9), 0x09)
    testing.assert_eq_i32(bin_to_bcd(10), 0x10)
    testing.assert_eq_i32(bin_to_bcd(59), 0x59)
    testing.assert_eq_i32(bcd_to_bin(0x59), 59)
    testing.assert_eq_i32(bcd_to_bin(0x23), 23)
}

fn test_set_read_roundtrip() {
    let mut rec = Rec{
        nwrite: 0,
        nwr: 0,
        last_addr: 0,
        mem: [cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0)],
        fail: 0,
        last_wlen: 0
    }
    let dev = attach(mock_wire(&rec))
    testing.assert_eq_i32(dev.set_time(45, 30, 14, 1, 2, 9, 26), err_ok())
    testing.assert_eq_i32(rec.last_addr, 0x51)
    testing.assert_eq_i32(rec.last_wlen, 8)
    let mut sec: i32 = 0
    let mut min: i32 = 0
    let mut hour: i32 = 0
    let mut day: i32 = 0
    let mut wday: i32 = 0
    let mut month: i32 = 0
    let mut year: i32 = 0
    testing.assert_eq_i32(dev.read_time(&sec, &min, &hour, &day, &wday, &month, &year), err_ok())
    testing.assert_eq_i32(sec, 45)
    testing.assert_eq_i32(min, 30)
    testing.assert_eq_i32(hour, 14)
    testing.assert_eq_i32(day, 1)
    testing.assert_eq_i32(wday, 2)
    testing.assert_eq_i32(month, 9)
    testing.assert_eq_i32(year, 26)
}

fn test_set_bad_arg() {
    let mut rec = Rec{
        nwrite: 0,
        nwr: 0,
        last_addr: 0,
        mem: [cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0), cast(u8, 0)],
        fail: 0,
        last_wlen: 0
    }
    let dev = attach(mock_wire(&rec))
    testing.assert_eq_i32(dev.set_time(60, 0, 0, 1, 0, 1, 0), err_bad_arg())
    testing.assert_eq_i32(dev.set_time(0, 0, 0, 1, 0, 13, 0), err_bad_arg())
}
