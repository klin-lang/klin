/// Board glue: PCF85063 RTC via onboard I2C + `klin_pcf85063`.
module waveshare_esp32_s3_rlcd_42

import "github/klin-lang/klin_pcf85063" rtc

fn rtc_wire_write(ctx: *mut u8, addr7: i32, data: *u8, len: i32): i32 {
    let _c = ctx
    return i2c_write(addr7, data, len)
}

fn rtc_wire_read(ctx: *mut u8, addr7: i32, buf: *mut u8, len: i32): i32 {
    let _c = ctx
    return i2c_read(addr7, buf, len)
}

fn rtc_wire_write_read(ctx: *mut u8, addr7: i32, wdata: *u8, wlen: i32, rbuf: *mut u8, rlen: i32): i32 {
    let _c = ctx
    return i2c_write_read(addr7, wdata, wlen, rbuf, rlen)
}

fn rtc_wire_delay(ctx: *mut u8, ms: i32) {
    klin_rlcd_wire_delay_ms(ctx, ms)
}

fn board_rtc_wire(): rtc.Wire {
    return rtc.Wire{
        ctx: cast(*mut u8, 0),
        write: rtc_wire_write,
        read: rtc_wire_read,
        write_read: rtc_wire_write_read,
        delay_ms: rtc_wire_delay
    }
}

/// Ensure I2C init, then read RTC datetime (year 0..99).
pub fn rtc_read(
    sec: *mut i32,
    min: *mut i32,
    hour: *mut i32,
    day: *mut i32,
    wday: *mut i32,
    month: *mut i32,
    year: *mut i32
): i32 {
    let e = i2c_init()
    if e != 0 {
        return e
    }
    let dev = rtc.attach(board_rtc_wire())
    return dev.read_time(sec, min, hour, day, wday, month, year)
}

/// Ensure I2C init, then set RTC datetime.
pub fn rtc_set(
    sec: i32,
    min: i32,
    hour: i32,
    day: i32,
    wday: i32,
    month: i32,
    year: i32
): i32 {
    let e = i2c_init()
    if e != 0 {
        return e
    }
    let dev = rtc.attach(board_rtc_wire())
    return dev.set_time(sec, min, hour, day, wday, month, year)
}
