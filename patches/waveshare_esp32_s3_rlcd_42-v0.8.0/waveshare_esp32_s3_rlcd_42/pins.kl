/// Waveshare ESP32-S3-RLCD-4.2 pin map (silkscreen / schematic).
/// Display bus + KEY/BOOT + I2C + TF + audio I2S/PA + battery ADC.
/// Protocol helpers: `i2c.kl`, `tf.kl`, `audio.kl` — not radio.
module waveshare_esp32_s3_rlcd_42

pub fn lcd_sck(): i32 {
    return 11
}

pub fn lcd_mosi(): i32 {
    return 12
}

pub fn lcd_dc(): i32 {
    return 5
}

pub fn lcd_cs(): i32 {
    return 40
}

pub fn lcd_rst(): i32 {
    return 41
}

pub fn key(): i32 {
    return 18
}

pub fn boot(): i32 {
    return 0
}

pub fn i2c_sda(): i32 {
    return 13
}

pub fn i2c_scl(): i32 {
    return 14
}

/// Battery sense (ADC1), after a ×3 resistor divider.
pub fn battery_gpio(): i32 {
    return 4
}

/// Panel width (landscape RAM addressing).
pub fn lcd_width(): i32 {
    return 400
}

/// Panel height (landscape RAM addressing).
pub fn lcd_height(): i32 {
    return 300
}

/// Caller framebuffer size in bytes: (width/2)*(height/4) = 15000.
pub fn fb_bytes(): i32 {
    return 15000
}

/// TF SDMMC CLK (1-bit).
pub fn tf_clk(): i32 {
    return 38
}

/// TF SDMMC CMD.
pub fn tf_cmd(): i32 {
    return 21
}

/// TF SDMMC D0.
pub fn tf_d0(): i32 {
    return 39
}

/// VFS mount point used by `tf_mount`.
pub fn tf_mount_path(): str {
    return "/sdcard"
}

/// I2S MCLK (to ES8311 / ES7210).
pub fn audio_mclk(): i32 {
    return 16
}

/// I2S BCLK.
pub fn audio_bclk(): i32 {
    return 9
}

/// I2S LRCLK / WS.
pub fn audio_ws(): i32 {
    return 45
}

/// I2S DOUT → ES8311 DAC.
pub fn audio_dout(): i32 {
    return 8
}

/// I2S DIN ← ES7210 ADC.
pub fn audio_din(): i32 {
    return 10
}

/// Speaker amplifier enable.
pub fn audio_pa(): i32 {
    return 46
}

/// ES8311 7-bit I2C address.
pub fn audio_es8311_addr(): i32 {
    return 24
}

/// ES7210 7-bit I2C address.
pub fn audio_es7210_addr(): i32 {
    return 64
}
