// Hardware: SHTC3 measure + PCF85063 RTC read/set via board glue.
import "github/klin-lang/waveshare_esp32_s3_rlcd_42" board

@[cexport, codename("klin_app_main")]
fn app_main_klin() {
  let mut t: i32 = 0
  let mut h: i32 = 0
  let mut e = board.shtc3_measure(&t, &h)
  let _t = t
  let _h = h
  let _e = e

  e = board.rtc_set(0, 0, 12, 1, 1, 9, 26)
  let mut sec: i32 = 0
  let mut min: i32 = 0
  let mut hour: i32 = 0
  let mut day: i32 = 0
  let mut wday: i32 = 0
  let mut month: i32 = 0
  let mut year: i32 = 0
  e = board.rtc_read(&sec, &min, &hour, &day, &wday, &month, &year)
  let _keep = e + sec + min + hour + day + wday + month + year
  while true {
    let mut i: i32 = 0
    while i < 20000000 {
      i = i + 1
    }
  }
}

fn main() {
  app_main_klin()
}
