new file mode 100644
index 0000000..0e08012
--- /dev/null
+++ b/examples/lcd_counter/lcd_counter.kl
@@ -0,0 +1,27 @@
+/// White LCD, black 5×7 font, `x:` increments once per second (no blanking).
+/// LCD text uses `[]i32` + `format_label_u32` — host `"x: $x"` is print-only
+/// (`printf` / `puts`), not the font API.
+import "../../waveshare_rp2350_lcd_096" board
+
+@[link("startup.s")]
+@[link("image_def.S")]
+fn main() {
+    let lcd = board.lcd_out(12000000, 1000000)
+    lcd.backlight(true)
+    lcd.fill(board.color_white())
+
+    let mut prefix: [2]i32
+    prefix[0] = 'x'
+    prefix[1] = ':'
+    let mut empty: [1]i32
+
+    let mut x: i32 = 0
+    while true {
+        let mut line: [16]i32
+        let n = board.format_label_u32(line[:], prefix[:], x, empty[:0])
+        lcd.fill_rect(8, 28, 144, 16, board.color_white())
+        lcd.draw_text_n(8, 28, line[:], n, board.color_black(), board.color_white())
+        board.delay_ms(1000)
+        x = x + 1
+    }
+}
diff --git a/examples/lcd_counter/linker.ld b/examples/lcd_counter/linker.ld
new file mode 100644
index 0000000..82fd950
--- /dev/null
+++ b/examples/lcd_counter/linker.ld
@@ -0,0 +1,37 @@
+ENTRY(Reset_Handler)
+
+MEMORY
+{
+  FLASH (rx)  : ORIGIN = 0x10000000, LENGTH = 4M
+  RAM (rwx)   : ORIGIN = 0x20000000, LENGTH = 512K
+}
+
+_estack = ORIGIN(RAM) + LENGTH(RAM);
+
+SECTIONS
+{
+  .text :
+  {
+    KEEP(*(.isr_vector))
+    KEEP(*(.picobin_block))
+    *(.text*)
+    *(.rodata*)
+  } > FLASH
+
+  .data :
+  {
+    _sdata = .;
+    *(.data*)
+    _edata = .;
+  } > RAM AT> FLASH
+
+  _sidata = LOADADDR(.data);
+
+  .bss (NOLOAD) :
+  {
+    _sbss = .;
+    *(.bss*)
+    *(COMMON)
+    _ebss = .;
+  } > RAM
+}
diff --git a/examples/lcd_counter/startup.s b/examples/lcd_counter/startup.s
new file mode 100644
index 0000000..0188a66
--- /dev/null
+++ b/examples/lcd_counter/startup.s
@@ -0,0 +1,79 @@
+.syntax unified
+.cpu cortex-m33
+.thumb
+
+.global Reset_Handler
+.extern main
+
+.section .isr_vector, "a", %progbits
+.word _estack
+.word Reset_Handler
+.word NMI_Handler
+.word HardFault_Handler
+.word MemManage_Handler
+.word BusFault_Handler
+.word UsageFault_Handler
+.word SecureFault_Handler
+.word 0
+.word 0
+.word 0
+.word SVC_Handler
+.word DebugMon_Handler
+.word 0
+.word PendSV_Handler
+.word SysTick_Handler
+
+.section .text.Reset_Handler, "ax", %progbits
+.thumb_func
+Reset_Handler:
+  ldr r0, =_sdata
+  ldr r1, =_edata
+  ldr r2, =_sidata
+1:
+  cmp r0, r1
+  bcs 2f
+  ldr r3, [r2]
+  str r3, [r0]
+  adds r2, #4
+  adds r0, #4
+  b 1b
+2:
+  ldr r0, =_sbss
+  ldr r1, =_ebss
+  movs r2, #0
+3:
+  cmp r0, r1
+  bcs 4f
+  str r2, [r0]
+  adds r0, #4
+  b 3b
+4:
+  bl main
+5:
+  b 5b
+
+.section .text.Default_Handler, "ax", %progbits
+.thumb_func
+Default_Handler:
+  b .
+
+.weak NMI_Handler
+.thumb_set NMI_Handler, Default_Handler
+.weak HardFault_Handler
+.thumb_set HardFault_Handler, Default_Handler
+.weak MemManage_Handler
+.thumb_set MemManage_Handler, Default_Handler
+.weak BusFault_Handler
+.thumb_set BusFault_Handler, Default_Handler
+.weak UsageFault_Handler
+.thumb_set UsageFault_Handler, Default_Handler
+.weak SecureFault_Handler
+.thumb_set SecureFault_Handler, Default_Handler
+.weak SVC_Handler
+.thumb_set SVC_Handler, Default_Handler
+.weak DebugMon_Handler
+.thumb_set DebugMon_Handler, Default_Handler
+.weak PendSV_Handler
+.thumb_set PendSV_Handler, Default_Handler
+.weak SysTick_Handler
+.thumb_set SysTick_Handler, Default_Handler
