/// Crude busy-wait. Duration depends on clk_sys — explicit loop, no timers.
module waveshare_rp2350_lcd_096

pub fn busy_wait(n: i32) {
    let mut i: i32 = 0
    while i < n {
        i = i + 1
    }
}

/// Rough millisecond spin at ~default ROSC (tune on hardware if needed).
pub fn delay_ms(ms: i32) {
    let mut m = ms
    if m < 0 {
        m = 0
    }
    // ~1000 iters ≈ 1 ms at a few MHz — scale up for margin on RP2350 default clock.
    busy_wait(m * 8000)
}
