/// RGB565 colors in Waveshare Pico-LCD-0.96 wire/buffer order (byte-swapped).
module waveshare_rp2350_lcd_096

pub fn color_black(): i32 {
    return 0x0000
}

pub fn color_white(): i32 {
    return 0xFFFF
}

/// Waveshare demo RED (0xF800 byteswapped).
pub fn color_red(): i32 {
    return 0x00F8
}

pub fn color_green(): i32 {
    return 0xE007
}

pub fn color_blue(): i32 {
    return 0x1F00
}

pub fn color_yellow(): i32 {
    return 0xE0FF
}

pub fn color_cyan(): i32 {
    return 0xFF07
}

pub fn color_magenta(): i32 {
    return 0x1FF8
}

/// Pack 8-bit RGB into Waveshare-endian RGB565.
pub fn rgb565(r: i32, g: i32, b: i32): i32 {
    let c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | ((b & 0xF8) >> 3)
    return ((c & 0xFF) << 8) | ((c >> 8) & 0xFF)
}
