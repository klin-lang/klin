/// Color bars + block “KLIN” mark — no font table in MVP.
import "../../waveshare_rp2350_lcd_096" board

fn draw_bar(lcd: board.Lcd, y: i32, h: i32, color: i32) {
    lcd.fill_rect(0, y, 160, h, color)
}

fn draw_klin_blocks(lcd: board.Lcd) {
    // Crude 4-letter blocks for K L I N
    let y = 28
    let h = 24
    // K
    lcd.fill_rect(12, y, 6, h, board.color_white())
    lcd.fill_rect(18, y, 10, 6, board.color_white())
    lcd.fill_rect(18, y + 9, 10, 6, board.color_white())
    lcd.fill_rect(24, y + 15, 6, 9, board.color_white())
    // L
    lcd.fill_rect(40, y, 6, h, board.color_white())
    lcd.fill_rect(40, y + h - 6, 16, 6, board.color_white())
    // I
    lcd.fill_rect(68, y, 6, h, board.color_white())
    // N
    lcd.fill_rect(86, y, 6, h, board.color_white())
    lcd.fill_rect(92, y, 10, 6, board.color_white())
    lcd.fill_rect(102, y, 6, h, board.color_white())
}

@[link("startup.s")]
@[link("image_def.S")]
fn main() {
    let lcd = board.lcd_out(12000000, 1000000)
    lcd.backlight(true)

    while true {
        draw_bar(lcd, 0, 16, board.color_red())
        draw_bar(lcd, 16, 16, board.color_yellow())
        draw_bar(lcd, 32, 16, board.color_green())
        draw_bar(lcd, 48, 16, board.color_cyan())
        draw_bar(lcd, 64, 16, board.color_blue())
        board.delay_ms(1000)

        lcd.fill(board.color_black())
        draw_klin_blocks(lcd)
        lcd.hline(8, 8, 144, board.color_magenta())
        lcd.hline(8, 71, 144, board.color_magenta())
        board.delay_ms(1200)
    }
}
