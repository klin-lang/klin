/// Nested rectangles / border on ST7735S.
import "../../waveshare_rp2350_lcd_096" board

@[link("startup.s")]
@[link("image_def.S")]
fn main() {
    let lcd = board.lcd_out(12000000, 1000000)
    lcd.backlight(true)
    lcd.fill(board.color_black())

    while true {
        lcd.fill(board.color_black())
        lcd.fill_rect(0, 0, 160, 80, board.color_blue())
        lcd.fill_rect(10, 10, 140, 60, board.color_black())
        lcd.fill_rect(20, 20, 120, 40, board.color_green())
        lcd.fill_rect(40, 30, 80, 20, board.color_red())
        board.delay_ms(800)

        lcd.fill(board.color_white())
        lcd.hline(0, 0, 160, board.color_blue())
        lcd.hline(0, 79, 160, board.color_blue())
        lcd.vline(0, 0, 80, board.color_blue())
        lcd.vline(159, 0, 80, board.color_blue())
        board.delay_ms(800)
    }
}
